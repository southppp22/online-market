{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "maxWorkers": 1,
  "globalSetup": "<rootDir>/helpers/e2e-global-setup.ts",
  "setupFiles": ["<rootDir>/helpers/e2e-env.ts"]
}
